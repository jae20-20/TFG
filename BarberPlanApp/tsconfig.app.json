/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": [],
    "baseUrl": "./", // Configuración para rutas relativas
    "paths": {
      "@app/*": ["src/app/*"], // Alias para acceder a la carpeta app
      "@assets/*": ["src/assets/*"], // Alias para la carpeta de assets
      "@environments/*": ["src/environments/*"] // Alias para entornos
    }
  },
  "files": [
    "src/main.ts",
    "src/polyfills.ts"
  ],
  "include": [
    "src/**/*.d.ts"
  ]
}